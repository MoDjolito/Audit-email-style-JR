#!/usr/bin/env node
// ============================================================
// TEST API — Verifie la connexion Klaviyo pour un client donne
// ============================================================
// Usage:
//   KLAVIYO_AUDIT_CLIENT=skwheel node test-api.js
// ============================================================

const config = require("./config");

const BASE_URL = "https://a.klaviyo.com/api";
const HEADERS = {
  Authorization: `Klaviyo-API-Key ${config.KLAVIYO_API_KEY}`,
  revision: config.KLAVIYO_API_REVISION,
  Accept: "application/vnd.api+json",
};

async function testConnection() {
  console.log("Test de connexion Klaviyo");
  console.log("Client : " + config.CLIENT.name + "  (slug: " + config.CLIENT_SLUG + ")");
  console.log("");

  if (!config.KLAVIYO_API_KEY || !config.KLAVIYO_API_KEY.startsWith("pk_")) {
    console.error("ERREUR: Cle API absente ou invalide (doit commencer par pk_).");
    console.error("Verifier ~/.klaviyo-audit/clients/" + config.CLIENT_SLUG + ".json");
    process.exit(1);
  }

  let allOk = true;

  // Test 1: metriques
  try {
    const r = await fetch(`${BASE_URL}/metrics`, { headers: HEADERS });
    if (!r.ok) throw new Error(`Status ${r.status}: ${await r.text()}`);
    const data = await r.json();
    const count = data.data?.length || 0;
    console.log(`[OK] Metriques accessibles — ${count} chargees (echantillon de la 1ere page)`);

    // Detection integration
    const placedOrders = (data.data || []).filter(m =>
      m.attributes?.name === "Placed Order" && m.attributes?.integration?.name
    );
    if (placedOrders.length > 0) {
      console.log("     Integrations e-commerce detectees:");
      placedOrders.forEach(m => console.log(`       - ${m.attributes.integration.name}`));
    }
  } catch (err) {
    console.error("[FAIL] Metriques:", err.message);
    allOk = false;
  }

  // Test 2: campagnes
  try {
    const r = await fetch(`${BASE_URL}/campaigns?filter=equals(messages.channel,'email')`, { headers: HEADERS });
    if (!r.ok) throw new Error(`Status ${r.status}: ${await r.text()}`);
    const data = await r.json();
    const count = data.data?.length || 0;
    console.log(`[OK] Campagnes accessibles — ${count} sur la 1ere page`);
    if (data.data && data.data.length > 0) {
      console.log("     Dernieres :");
      data.data.slice(0, 3).forEach(c =>
        console.log(`       - ${c.attributes?.name} (${c.attributes?.status})`)
      );
    }
  } catch (err) {
    console.error("[FAIL] Campagnes:", err.message);
    allOk = false;
  }

  // Test 3: flows
  try {
    const r = await fetch(`${BASE_URL}/flows`, { headers: HEADERS });
    if (!r.ok) throw new Error(`Status ${r.status}: ${await r.text()}`);
    const data = await r.json();
    const count = data.data?.length || 0;
    console.log(`[OK] Flows accessibles — ${count} sur la 1ere page`);
  } catch (err) {
    console.error("[FAIL] Flows:", err.message);
    allOk = false;
  }

  console.log("");
  if (allOk) {
    console.log("Connexion OK. Pret a generer un rapport via /audit-klaviyo.");
  } else {
    console.error("Au moins un test a echoue. Verifier la cle API et les permissions (Read-only sur Campaigns, Flows, Metrics, Profiles, Lists).");
    process.exit(1);
  }
}

testConnection();
